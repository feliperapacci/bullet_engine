{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BANG_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": { 
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release (optimized, with debug info)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "sanitized",
            "displayName": "Debug + ASan/UBSan",
            "inherits": "debug",
            "cacheVariables": { 
                "BANG_SANITIZE": "ON"
            }
        },
        {
            "name": "ci",
            "displayName": "CI (warnings are errors)",
            "inherits": "debug",
            "cacheVariables": { "BANG_WARNINGS_AS_ERRORS": "ON" }
        }
    ],

    "buildPresets": [
        { "name": "debug",      "configurePreset": "debug" },
        { "name": "release",    "configurePreset": "release" },
        { "name": "sanitized",  "configurePreset": "sanitized" },
        { "name": "ci",         "configurePreset": "ci" }
    ],

    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        { "name": "debug",      "inherits": "base", "configurePreset": "debug" },
        { "name": "release",    "inherits": "base", "configurePreset": "release" },
        { "name": "sanitized",  "inherits": "base", "configurePreset": "sanitized" },
        { "name": "ci",         "inherits": "base", "configurePreset": "ci" }
    ],

    "workflowPresets": [
        {
            "name": "debug",
            "steps": [
                { "type": "configure", "name": "debug" },
                { "type": "build",     "name": "debug" },
                { "type": "test",      "name": "debug" }
            ]
        },
        {
            "name": "release",
            "steps": [
                { "type": "configure", "name": "release" },
                { "type": "build",     "name": "release" },
                { "type": "test",      "name": "release" }
            ]
        },
        {
            "name": "sanitized",
            "steps": [
                { "type": "configure", "name": "sanitized" },
                { "type": "build",     "name": "sanitized" },
                { "type": "test",      "name": "sanitized" }
            ]
        },
        {
            "name": "ci",
            "steps": [
                { "type": "configure", "name": "ci" },
                { "type": "build",     "name": "ci" },
                { "type": "test",      "name": "ci" }
            ]
        }
    ]
}
